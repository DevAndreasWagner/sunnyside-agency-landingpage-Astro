---
import { Image } from "astro:assets";

interface Props {
  imagePath?: any;
  altText: string;
  loading?: string;
  class?: string;
}

const { imagePath, altText, loading = "lazy", class: className } = Astro.props;

---

<div class:list={["overflow-hidden", className]}>
    <Image 
    src={imagePath}
    alt={altText}
    widths={[412, 1024, 1440, 2560]}
    sizes={`(max-width: 412px) 412px, (max-width: 1024px) 1024px, (max-width: 1440px) 1440px, 2560px`}
    fetchpriority={loading === "eager" ? "high" : "auto"}
    decoding={loading === "eager" ? "sync" : "async"}
    class="w-full h-full object-cover"
    />
</div>

